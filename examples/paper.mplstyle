# Publication figure style for the ELVIS example notebooks.
# Usage: plt.style.use("paper.mplstyle")
# Series colours: validated categorical slots 1-3 (blue, orange, aqua) - pass CVD checks on
# white for all pairs; aqua is below 3:1 contrast, so series are always labelled directly.

figure.figsize: 6.8, 2.8
figure.dpi: 150
figure.facecolor: white
figure.constrained_layout.use: True
savefig.dpi: 300
savefig.format: pdf
savefig.bbox: tight
savefig.facecolor: white
pdf.fonttype: 42
ps.fonttype: 42

font.family: sans-serif
font.sans-serif: Helvetica, Arial, DejaVu Sans
font.size: 8
axes.titlesize: 9
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
legend.frameon: False

text.color: 0b0b0b
axes.labelcolor: 52514e
axes.edgecolor: c3c2b7
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: e1e0d9
grid.linewidth: 0.5
xtick.color: 898781
ytick.color: 898781
xtick.labelcolor: 52514e
ytick.labelcolor: 52514e
xtick.major.size: 2.5
ytick.major.size: 0
xtick.major.width: 0.6

axes.prop_cycle: cycler("color", ["2a78d6", "eb6834", "1baf7a"])
lines.linewidth: 1.4
lines.solid_capstyle: round
patch.linewidth: 0
image.cmap: Blues
